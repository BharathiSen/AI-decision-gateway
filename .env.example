# Copy to .env and fill in real keys. .env is gitignored.
# Live Mininet / label / calibration runs use WSL Ubuntu-22.04 (not VirtualBox).
# From Windows: wsl -d Ubuntu-22.04, then sudo python3 … in the repo mount.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=none
GEMINI_API_KEY=AQ....

# Fallback when Gemini hits quota (use a *different* Groq model than any primary):
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_...
